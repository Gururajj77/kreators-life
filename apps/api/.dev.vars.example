# Copy to apps/api/.dev.vars (gitignored). Every key is optional locally.
# Admin console before the first admin account.
ADMIN_KEY=dev-admin-key
# Extra founder addresses that become admins on sign-up or sign-in (the three built in are in apps/api/src/admins.ts).
ADMIN_EMAILS=
# Mail (receipts, confirmations, invoices). Without a key, every mail lands in email_outbox (Admin can read it) and nothing is sent.
# Resend: an API key with "Sending access", and a From on a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=kreators.app <hello@yourdomain.com>
# The content strategist. Claude writes the pieces when this is set (claude-opus-5-5 unless ANTHROPIC_MODEL says otherwise); without it the app lays the research out as a draft.
ANTHROPIC_API_KEY=
# Agent Reach bridge: node scripts/reach/server.mjs on a machine where agent-reach is installed, and the key it was started with.
# Without it, Content can still read plain web pages, and YouTube only through the key below.
REACH_URL=
REACH_KEY=
# YouTube Data API v3 key (Google Cloud console, API key restricted to the YouTube Data API). The fallback for reading and
# searching YouTube when Agent Reach is not connected.
YOUTUBE_API_KEY=
# The assistant's model, for typing to the assistant (its tap flows work without it). Any OpenAI-compatible endpoint:
# OpenRouter by default. The panel picks from OpenRouter's free models (ASSISTANT_MODELS in packages/shared); this is
# the default when nothing is picked. Free models need the OpenRouter account's privacy settings to allow free
# endpoints that keep data (openrouter.ai/settings/privacy), and allow 50 requests a day until it has bought US$10.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Only for a model not listed in MODEL_PRICES (packages/shared): its price in US dollars per million tokens.
ASSISTANT_PRICE_IN=
ASSISTANT_PRICE_OUT=
# For a model that is not on the free list: zero-retention providers only, on by default because the assistant can read
# the journal when asked. "off" drops that ask for a model with no zero-retention host, and the journal and tracker reads go with it.
ASSISTANT_ZDR=
# The site's own address, used for links in mail (the password reset link included; it is never built from the request).
# Locally http://localhost:5173. In production set it as a Worker variable: https://kreators.app
PUBLIC_URL=
# Salt for hashing click addresses and anonymous aliases. A long random value in production (a secret).
CLICK_SALT=
# Razorpay. Without them checkout stays in test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Meta (Auto-DM). Without them the webhook is off.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
# The business shown on the contact page and in mail footers (Worker variables).
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_REG=
BUSINESS_VAT=
DMCA_AGENT=
DMCA_ADDRESS=
DMCA_EMAIL=
DMCA_REGISTERED=
