{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kreators-life",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every fifteen minutes: post-purchase sequences, content and reward view refreshes.
  "triggers": { "crons": ["*/15 * * * *"] },
  // The built web app is served as static assets by the same Worker.
  // Any /api/* request runs the Worker; everything else is a file or the SPA shell.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/go/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kreators-life",
      // Replace with the id printed by: pnpm --filter @kreators/api exec wrangler d1 create kreators-life
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
