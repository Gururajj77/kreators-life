{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kreators-life",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Smart placement runs the Worker near the database, since nearly every request makes several round trips to it.
  "placement": { "mode": "smart" },
  // Every fifteen minutes: post-purchase sequences, content and reward view refreshes.
  "triggers": { "crons": ["*/15 * * * *", "0 */2 * * *"] },
  // The built web app is served as static assets by the same Worker.
  // Any /api/* request runs the Worker; everything else is a file or the SPA shell.
  // The site home ("/") also runs the Worker, which fills in the absolute share-image URL for link previews.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The second list sends paths that should hold nothing (hidden files, backups, dumps, config) to the Worker, which answers 404
    // instead of the app shell (see blockedPath in src/headers.ts, the real rule; keep the two in step). /.well-known/ is left alone.
    "run_worker_first": [
      "/", "/api/*", "/go/*", "/out/*", "/__scheduled", "/sitemap.xml",
      "!/.well-known/*",
      "/.*", "/*/.*", "/*.map", "/*.sql", "/*.bak", "/*.zip", "/*.tar", "/*.tar.gz", "/*.tgz", "/*.php", "/*.log", "/*.pem", "/*.key", "/*.env",
      "/backup*", "/db.*", "/dump.*", "/database.*", "/config.*", "/configuration.*", "/settings.json", "/secret*", "/credentials.*",
      "/package.json", "/package-lock.json", "/pnpm-lock.yaml", "/yarn.lock", "/composer.*", "/tsconfig.json", "/vite.config.*", "/wrangler.*",
      "/docker-compose.*", "/Dockerfile", "/Makefile", "/wp-*", "/phpmyadmin*", "/cgi-bin/*", "/node_modules/*", "/id_rsa*", "/server-status*",
      "/src/*", "/logs/*", "/tmp/*", "/temp/*"
    ]
  },
  // The business behind kreators.app is set as Worker variables in the dashboard (or with "vars" here), never with a value in code.
  // They are left commented out, because an empty "vars" entry would wipe a value set in the dashboard on the next deploy.
  // "vars": {
  //   "BUSINESS_NAME": "", "BUSINESS_ADDRESS": "", "BUSINESS_EMAIL": "", "BUSINESS_REG": "", "BUSINESS_VAT": "",
  //   // The Grievance Officer for people in India (DPDP Act 2023, IT Rules 2021); the phone is optional.
  //   "BUSINESS_GRIEVANCE_NAME": "", "BUSINESS_GRIEVANCE_EMAIL": "", "BUSINESS_GRIEVANCE_PHONE": "",
  //   "DMCA_AGENT": "", "DMCA_ADDRESS": "", "DMCA_EMAIL": "", "DMCA_REGISTERED": ""
  // },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kreators-life",
      // Replace with the id printed by: pnpm --filter @kreators/api exec wrangler d1 create kreators-life
      "database_id": "f51fe3e1-1807-4bf7-8b6d-385e17df535f",
      "migrations_dir": "migrations"
    }
  ]
}
