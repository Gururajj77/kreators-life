{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kreators-life",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every fifteen minutes: post-purchase sequences, content and reward view refreshes.
  "triggers": { "crons": ["*/15 * * * *"] },
  // The built web app is served as static assets by the same Worker.
  // Any /api/* request runs the Worker; everything else is a file or the SPA shell.
  // The site home ("/") also runs the Worker, which fills in the absolute share-image URL for link previews.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/go/*", "/out/*", "/__scheduled", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kreators-life",
      // Replace with the id printed by: pnpm --filter @kreators/api exec wrangler d1 create kreators-life
      "database_id": "f51fe3e1-1807-4bf7-8b6d-385e17df535f",
      "migrations_dir": "migrations"
    }
  ]
}
